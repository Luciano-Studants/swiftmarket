# Copie para .env e ajuste. Em produção, JWT_SECRET é obrigatório.
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Persistência
DB_FILE=./data/swiftmarket.db
UPLOAD_DIR=./data/uploads

# Segurança
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# CORS: lista separada por vírgula (vazio em desenvolvimento = libera tudo).
# O APK Android roda em https://localhost (androidScheme "https" do Capacitor);
# o painel admin e o app no navegador usam as portas do Vite. Em PRODUÇÃO use só as
# origens reais, ex.: https://localhost,https://admin.seudominio.com
CORS_ORIGINS=https://localhost,http://localhost:5173,http://localhost:5174

# Só ative atrás de proxy reverso confiável (Caddy/Nginx); com a API exposta burla o rate limit.
TRUST_PROXY=false

# Admin inicial (obrigatório em produção; em desenvolvimento há usuários demo)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-mail de recuperação de senha. Obrigatório em produção; em desenvolvimento, sem SMTP_URL o
# código é impresso no log da API. Ex.: smtps://usuario:senha@smtp.seuprovedor.com:465
SMTP_URL=
MAIL_FROM=SwiftMarket <no-reply@seudominio.com>
