# URL base da API (sem /api/v1).
#   Navegador (npm run dev):  http://localhost:3333
#   Emulador Android:         http://10.0.2.2:3333   (precisa de HTTPS no app instalado, veja o README)
#   Produção:                 https://api.seudominio.com
VITE_API_URL=http://localhost:3333

# Botões "Google/Apple" simulados. Sempre ativos em `npm run dev`;
# em build de produção só aparecem se for "true" (a API também bloqueia em produção).
VITE_ENABLE_SOCIAL=false
