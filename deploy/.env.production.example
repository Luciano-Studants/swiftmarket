# Domínios (DNS A/AAAA apontando para o servidor)
API_DOMAIN=api.seudominio.com
ADMIN_DOMAIN=admin.seudominio.com

# Segredo do JWT: gere com `openssl rand -hex 48`
JWT_SECRET=

# Primeiro administrador (criado na primeira subida; em produção não há usuários demo)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-mail (recuperação de senha). Qualquer provedor SMTP serve (Resend, Brevo, Mailgun, SES, Gmail
# com senha de app...). Formato: smtps://usuario:senha@host:465  (senha com símbolos: URL-encode)
SMTP_URL=
MAIL_FROM=SwiftMarket <no-reply@seudominio.com>
